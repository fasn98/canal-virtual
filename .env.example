# Copie este arquivo para .env e preencha com suas chaves reais.
# O .env já está no .gitignore — nunca commite suas chaves reais.

ELEVENLABS_API_KEY=coloque_sua_chave_aqui
ELEVENLABS_VOICE_ID=coloque_o_id_da_voz_aqui

# --- Freio de gasto diário na ElevenLabs (serviço "synthesizer") ---
# Teto de créditos/dia para a síntese de voz de NOVAS notícias, INDEPENDENTE de
# quantas fontes de notícia estejam ativas. Plano Creator = 121.038 créditos/mês
# / 30 ≈ 4.034/dia; o padrão 4000 já embute uma margem de segurança. No modelo
# multilingual v2 (o que usamos) 1 caractere enviado ≈ 1 crédito.
# Como funciona: o synthesizer soma os caracteres de cada chamada bem-sucedida
# numa chave Redis por dia ("elevenlabs:credits_used:AAAA-MM-DD", que expira
# sozinha em alguns dias). Antes de CADA chamada, se (uso de hoje + tamanho do
# texto) passaria do teto, ele NÃO chama a API. Nesse caso, em vez de pular o
# item, o synthesizer REPRISA em rotação (round-robin) uma notícia de hoje que
# já tem áudio real pago — indexada em "today:completed_items:AAAA-MM-DD" — e a
# republica em news.ready. O renderer remonta o vídeo com ffmpeg local, sem
# novo gasto de ElevenLabs/D-ID (o audio_file já existe e cai no cache). Só se
# ainda NÃO houver nenhuma notícia paga hoje (bem cedo no dia) é que ele volta
# ao comportamento antigo: marca budget_exceeded e o renderer pula o bloco —
# sem áudio dummy, sem sobrescrever o final.mp4 —, deixando o último bloco bom
# no ar. Blocos promocionais e o bot de engajamento no chat NÃO sofrem o freio.
# Para testar o limite rápido, baixe temporariamente para ~2000 e depois volte
# para 4000 (produção).
DAILY_CREDIT_BUDGET=4000

# URL de transmissão RTMP (ex: YouTube Live, Twitch, etc).
# Pegue a chave em: YouTube Studio > Criar > Transmitir ao vivo > Chave de stream
RTMP_URL=rtmp://a.rtmp.youtube.com/live2/sua_chave_de_stream_aqui

# --- Tradução automática do título (DeepL) ---
# Plano gratuito: 500 mil caracteres/mês. Gere a chave em
# https://www.deepl.com/pro-api (chaves do plano grátis terminam em ":fx";
# o código detecta e usa o host api-free.deepl.com automaticamente).
# Se ficar em branco, o pipeline NÃO trava — a manchete só continua em inglês.
DEEPL_API_KEY=coloque_sua_chave_aqui
# Idioma-alvo do canal, no formato de código que a DeepL espera em target_lang.
# "PT-BR" = português do Brasil. Cada instância/canal pode usar um valor diferente.
TARGET_LANGUAGE=PT-BR
# Timeout (segundos) da chamada à DeepL. Em caso de estouro, segue com o título original.
DEEPL_TIMEOUT_SEC=10
# Fontes cujo conteúdo já chega no idioma-alvo e NÃO devem passar pela DeepL
# (lista separada por vírgula, casa com o campo `source` do collector). Vazio =
# "Agência Brasil". Só tem efeito quando TARGET_LANGUAGE começa com "PT".
PT_NATIVE_SOURCES=

# --- Fontes de notícia (serviço "collector") ---
# BBC: RSS. Por padrão 5 feeds (world, business, technology,
# science_and_environment, health). Só preencha BBC_FEED_URLS se quiser trocar
# o conjunto — lista de URLs separada por vírgula.
BBC_FEED_URLS=
# The Guardian: Open Platform (https://open-platform.theguardian.com/). Gere a
# chave em open-platform.theguardian.com/access/. SEM chave, o collector usa só
# a BBC. Tier "developer": 5.000 req/dia, 12/s, uso NÃO-comercial, exige
# atribuição e link de volta para theguardian.com.
GUARDIAN_API_KEY=coloque_sua_chave_aqui
# Seções consultadas (1 chamada por seção por ciclo). Vazio = world,business,
# technology,science,environment,society.
GUARDIAN_SECTIONS=
GUARDIAN_PAGE_SIZE=15
# Agência Brasil (EBC): RSS oficial em https://agenciabrasil.ebc.com.br/feed/ ,
# já em PT-BR (o classifier NÃO manda para a DeepL — ver PT_NATIVE_SOURCES).
# Padrão de URL: https://agenciabrasil.ebc.com.br/rss/<categoria>/feed.xml
# (categorias: geral, politica, economia, internacional, justica, educacao,
# esportes, saude, direitos-humanos, alem do agregado "ultimasnoticias").
# Vazio/comentado = 4 feeds padrão (geral, politica, economia, internacional).
# Preencha (lista separada por vírgula) para trocar o conjunto.
AGENCIABRASIL_FEED_URLS=
# Intervalo entre ciclos de coleta (s). Em produção use 120 para ficar sob o
# limite diário do Guardian.
POLL_INTERVAL_SEC=60

# --- Mix de áudio do streamer ---
# Ajuste e rode `docker compose up -d streamer` — não precisa rebuild.
# Volume da música de fundo relativo ao original (0.15 = 15%). Menor = música mais baixa.
MUSIC_VOLUME=0.15
# Boost aplicado à voz da narradora antes da mixagem (5.0 = +14 dB).
VOICE_VOLUME=5.0

# --- Comentário gerado por IA (serviço "commentator", API da Anthropic) ---
# Gere a chave em https://console.anthropic.com. Se ficar em branco, o
# commentator NÃO trava: usa um comentário curto genérico como fallback.
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
# Só para chaves "identity-linked" (criadas no Console novo, atreladas ao seu
# login): a API exige o id do workspace, senão responde 400. Pegue em
# console.anthropic.com → Settings → Workspaces (formato "wrkspc_..."). Deixe em
# branco se sua chave já for de um workspace específico.
ANTHROPIC_WORKSPACE_ID=
# Modelo usado (geração do comentário + os 3 revisores + worldin3 + promoter).
# Pode trocar sem rebuild. claude-3-* e claude-2-* foram desativados pela
# Anthropic — use um modelo atual (claude-haiku-4-5, claude-sonnet-5, ...).
# ATENÇÃO ao prompt-caching do commentator: foi calibrado para o mínimo
# cacheável de 1024 tokens do Sonnet. Em claude-haiku-4-5 o mínimo é 4096
# tokens e os blocos estáticos (~1470/~1580 tok) NÃO cacheiam — os markers
# cache_control viram no-op silencioso (cache_creation_input_tokens=0).
ANTHROPIC_MODEL=claude-haiku-4-5
# Tamanho alvo do comentário, em palavras (~300 ≈ 2 min de fala).
# Reduza para ~40 durante testes rápidos e VOLTE para 300 antes de produção.
TARGET_COMMENTARY_WORDS=300

# --- Revisão editorial (serviço "commentator", entre commentator e synthesizer) ---
# Antes de o comentário virar áudio, 3 chamadas SEPARADAS ao Claude:
#   1) verificador de fatos  — pega número/nome/citação inventado que não está
#      no título/resumo da fonte;
#   2) revisor editorial     — tom, viés não-intencional, opinião como fato;
#   3) aprovador final        — LIBERA se ambos aprovaram; se não, devolve ao
#      commentator com o motivo para reescrever.
# Custo: +3 chamadas Claude por notícia ÚNICA (o cache por id evita repetir em
# reexibições). false = publica direto, sem revisão.
# As 4 chamadas (geração + 3 revisores) usam prompt-caching: as instruções
# estáticas vão no `system` com cache_control e um preâmbulo comum às 3 revisões
# é gravado uma vez e relido pelas outras a ~10% do custo. Cada chamada loga
# uma linha "tokens[<tipo>] input=.. cache_write=.. cache_read=.. output=.." —
# cache_read alto a partir da 2ª chamada = cache funcionando.
ENABLE_EDITORIAL_REVIEW=true
# Reescritas após reprovação antes de DESCARTAR o item (não publica, loga e
# segue para o próximo da fila).
MAX_CORRECTION_ATTEMPTS=2
# Modelo das revisões. Vazio = mesmo do comentário (ANTHROPIC_MODEL).
REVIEW_MODEL=

# --- Bloco promocional do canal irmão (serviço "promoter") ---
# Nº de notícias REAIS renderizadas entre uma chamada promocional e a próxima.
# O promoter escuta news.block e conta; ao atingir este valor injeta a promoção
# em news.final e zera o contador. Produção = 5 (ciclo de ~11 min).
NEWS_PER_PROMO=5

# --- Bot de engajamento no chat ao vivo do YouTube (serviço "promoter") ---
# Uma vez por BLOCO (junto com a chamada promocional, alinhado ao ciclo de
# NEWS_PER_PROMO notícias) o promoter gera via Claude uma pergunta curta em
# português sobre a notícia mais recente do bloco e posta no chat ao vivo,
# simulando enquete/quiz. Qualquer falha (token, chat, rate limit) é só logada:
# NUNCA quebra o pipeline principal.
ENABLE_ENGAGEMENT_BOT=false
#
# Autenticação: postar no chat exige OAuth2 (agir como o dono do canal), não
# basta a YOUTUBE_API_KEY. Gere as 3 credenciais abaixo rodando UMA vez, na sua
# máquina, `python3 promoter/get_refresh_token.py` (ver passo a passo). Precisa
# de um "OAuth client ID" tipo "Desktop app" no MESMO projeto do Google Cloud
# onde a YouTube Data API v3 está habilitada, com a tela de consentimento
# (Google Auth Platform) publicada "In production" e o escopo
# .../auth/youtube.force-ssl — senão o refresh token é revogado em 7 dias.
YOUTUBE_OAUTH_CLIENT_ID=coloque_seu_client_id_aqui
YOUTUBE_OAUTH_CLIENT_SECRET=coloque_seu_client_secret_aqui
YOUTUBE_OAUTH_REFRESH_TOKEN=coloque_seu_refresh_token_aqui
# Refresh token SEPARADO, com escopo de UPLOAD (youtube.upload +
# youtube.force-ssl), usado pelo "O Mundo em 3 Minutos" (serviço worldin3) para
# subir os Shorts e adicioná-los à playlist. MESMO client_id/secret acima, mas
# uma autorização à parte — NÃO sobrescreve o token do bot de chat. Gere com:
#   python3 -m worldin3.get_upload_token url
#   python3 -m worldin3.get_upload_token exchange "<url-de-retorno>" --write-env
YOUTUBE_OAUTH_REFRESH_TOKEN_UPLOAD=coloque_o_refresh_token_de_upload_aqui
#
# ID do vídeo da transmissão 24h (a parte depois de watch?v= na URL da live).
# Com ele o bot resolve o liveChatId por videos.list (1 unidade de cota).
# Em branco, o bot busca dinamicamente a live ativa do canal via
# liveBroadcasts.list (também 1 unidade). Preencher é mais robusto.
YOUTUBE_LIVE_VIDEO_ID=
#
# (Opcionais — têm padrão embutido)
# ENGAGEMENT_MODEL=            # modelo Claude p/ a pergunta; vazio = ANTHROPIC_MODEL
# ENGAGEMENT_CHATID_TTL_SEC=1800   # cache do liveChatId no Redis (a live pode reiniciar)

# --- Lip-sync real do avatar via D-ID (serviço "renderer") ---
# Prova de conceito, plano Pro (~US$29/mês). Deixe FALSE até decidir ativar.
# false = pipeline atual (apresentadora estática). true = o renderer envia o
# mp3 já gerado pela ElevenLabs + a foto assets/avatar_greenscreen.png (recorte
# da âncora sobre fundo verde) para o D-ID gerar um vídeo com lip-sync; o
# renderer remove o verde com chroma key e usa o vídeo na composição, sem o
# "retângulo flutuante". Qualquer falha na
# chamada ao D-ID cai automaticamente no avatar estático (igual ao fallback
# da ElevenLabs). Cache por id em assets/lipsync/{id}.mp4 (não regasta crédito).
# ATENÇÃO de custo: o plano Pro rende ~15 min de vídeo/mês (1 crédito ≤ 15s,
# ~60 créditos). No volume normal do canal isso acaba em poucas horas — ligue
# só em janelas curtas de demonstração.
ENABLE_LIPSYNC=false
# Chave de API do D-ID (D-ID Studio → Account Settings → API Key). Vem como
# "usuario:senha"; o código faz o base64 sozinho. Em branco = lip-sync off.
DID_API_KEY=coloque_sua_chave_aqui
# (Opcionais — só se precisar afinar; têm padrão embutido)
# DID_SOURCE_IMAGE=/app/assets/avatar_greenscreen.png  # recorte sobre fundo verde
# DID_POLL_TIMEOUT_SEC=240                   # espera máx. pelo render do D-ID
# DID_STITCH=true                            # cola o rosto animado na foto inteira
# Chroma key aplicado ao mp4 do D-ID antes da composição (afinar sem rebuild):
# DID_CHROMA_COLOR=0x00B140        # = cor de avatar_greenscreen.png
# DID_CHROMA_SIMILARITY=0.14       # maior remove mais verde (e arrisca comer a âncora)
# DID_CHROMA_BLEND=0.06            # maior = borda do recorte mais macia
# DID_CHROMA_DESPILL=true          # tira halo/borda verde em cabelo e ombros

# --- TV virtual no cenário (b-roll — serviço "renderer") ---
# Uma "TV" no lado esquerdo da cena (moldura assets/tv_frame.png) mostrando,
# em loop pela duração do bloco, um vídeo relacionado à notícia principal do
# bloco. 1 vídeo por bloco de NEWS_PER_PROMO notícias; cache por categoria.
# FONTES (nesta ordem): 1) nosso canal no YouTube (conteúdo próprio); 2) Pexels
# (b-roll genérico de banco); 3) clipe estático local. Qualquer falha em cascata
# => no pior caso o bloco sai SEM a TV e o pipeline não quebra.
ENABLE_TV=true

# Fonte 1 — canal próprio no YouTube (FutureVerse & Beyond).
# YOUTUBE_API_KEY: Google Cloud Console -> ativar "YouTube Data API v3" -> criar
# chave de API. Em branco (ou ENABLE_TV_YOUTUBE=false) = pula direto pro Pexels.
# search.list custa 100 unidades; cota padrão 10.000/dia. Como a busca é 1x por
# categoria (depois vira cache em assets/tv/yt/{categoria}.mp4), o gasto é baixo.
ENABLE_TV_YOUTUBE=true
YOUTUBE_API_KEY=coloque_sua_chave_aqui
YOUTUBE_CHANNEL_HANDLE=@FutureVerse-Beyond
# YOUTUBE_CHANNEL_ID=            # opcional: se setado, pula a resolução do handle
# TV_YT_CLIP_SECONDS=90          # baixa só os 1ºs N s do vídeo (0 = inteiro)
# TV_YT_FORMAT=bv*[height<=720]/bv*[height<=1080]/b[height<=720]/b   # yt-dlp -f
# TV_YT_DL_TIMEOUT_SEC=180       # teto do yt-dlp por download

# Fonte 2 — Pexels (grátis): https://www.pexels.com/api/ — 200 req/h, 20.000/mês.
PEXELS_API_KEY=coloque_sua_chave_aqui

# (Opcionais — têm padrão embutido)
# TV_X=60                 # canto sup. esquerdo da moldura na tela 1920x1080
# TV_Y=180
# TV_MAX_HEIGHT=1080      # teto de resolução do mp4 do Pexels (evita 4K)
# PEXELS_PER_PAGE=15      # resultados por busca
# TV_FALLBACK_CLIP=/app/assets/tv/_fallback.mp4  # clipe genérico p/ quando as 2 fontes falham

# --- Proteção contra itens de teste no ar (serviço "renderer") ---
# Um item de TESTE é reconhecido quando: o id NÃO está no formato de produção
# (o collector gera hash hex de 16 chars; promoções usam "promo-..."), OU o id
# começa com um prefixo de teste conhecido (test, teste, skiptest, lipsynctest,
# cache-test, cc-test, cgtest, budgettest, reprisetest, estudioteste, dummy,
# kill...), OU a manchete começa com "TESTE"/"TEST ".
# Por padrão um item de teste renderiza em /app/output/final_test.mp4 e NÃO
# toca no final.mp4 que o streamer transmite ao vivo — assim um teste nunca
# fica "preso" no ar quando o pipeline real não consegue produzir nada novo
# (ex.: ElevenLabs/D-ID sem crédito). Inspecione o final_test.mp4 e, se quiser
# mesmo mandar aquele teste pro ar, suba com ALLOW_TEST_ON_AIR=true.
# LIMITAÇÃO CONHECIDA: um teste injetado com um id hex de 16 chars E manchete
# que NÃO comece com "TESTE" passa despercebido. Sempre prefixe o id de teste
# (ex.: "skiptest-...", "teste-...") para a proteção valer.
ALLOW_TEST_ON_AIR=false

# --- Alerta de conteúdo parado / staleness (serviço "renderer") ---
# Se o final.mp4 de produção passar deste tempo (segundos) sem ser atualizado
# por um item REAL (não teste) bem-sucedido, o renderer loga:
#   "⚠️ ALERTA: final.mp4 sem atualização real há X min — possível problema de
#    API/crédito (ElevenLabs/D-ID) ou pipeline parado."
# Não interrompe nada — é só visibilidade rápida em log. Padrão 1200 (20 min).
# STALENESS_ALERT_AFTER_SEC=1200
# STALENESS_LOG_INTERVAL_SEC=300   # não repete o alerta antes disso (segundos)

# --- Recuperação automática de mensagens travadas nos Consumer Groups ---
# (classifier, commentator, synthesizer, renderer)
# Ajuste e rode `docker compose up -d` — não precisa rebuild.
#
# Tempo sem progresso para uma mensagem pendente ser considerada "travada" (ms).
STUCK_MESSAGE_TIMEOUT_MS=60000
# Nº máximo de tentativas de processamento antes de descartar (mensagem envenenada).
MAX_DELIVERY_ATTEMPTS=3
# Intervalo entre varreduras de mensagens travadas (segundos).
STUCK_SCAN_INTERVAL_SEC=30

# --- API de métricas (serviço "metrics-api") ---
# Serviço leve, SOMENTE LEITURA, na porta 8090, que expõe métricas de uso/custo
# do pipeline para um painel de controle externo (back-office no Replit). Ele só
# PRODUZ os dados; o painel visual fica fora do Contabo.
#
# Endpoints (todos GET, exigem o header "X-API-Key"):
#   /status/elevenlabs  orçamento diário de créditos (usado/total/restante)
#   /status/did         lip-sync ligado? + saldo real de créditos do D-ID +
#                       chamadas de hoje (sucesso/falha)
#   /status/claude      chamadas ao Claude hoje por tipo (commentary,
#                       fact_check, editorial, final_approval)
#   /status/pipeline    containers up, última "SUCESSO EMISSÃO" do renderer,
#                       taxa de cache hit/miss de hoje (comentário e áudio)
#   /status/all         tudo acima num JSON só
#   /health             liveness SEM token e SEM dados (para uptime check)
#
# SEGURANÇA: o valor abaixo é o token fixo comparado (constant-time) com o
# header "X-API-Key". Sem o header correto TODA rota /status/* responde 401 —
# nunca os dados. Se METRICS_API_KEY ficar em branco, a API responde 503 a tudo
# (fail-closed). Como o Replit consulta de fora do Contabo, a porta 8090
# precisa estar acessível pela internet: libere-a no firewall do Contabo APENAS
# na porta 8090 (o token faz o resto). Para fechar no host e usar só um túnel,
# troque o mapeamento no docker-compose.yml para "127.0.0.1:8090:8090".
# Gere um valor longo e aleatório, ex.: openssl rand -hex 32
METRICS_API_KEY=coloque_um_token_aleatorio_longo_aqui
# (Opcionais — têm padrão embutido)
# DID_API_URL=https://api.d-id.com
# EXPECTED_CONTAINERS=redis,collector,classifier,commentator,promoter,synthesizer,renderer,streamer,metrics-api

# --- Ponte com o TubeOptimizer (lib/tubeoptimizer_client.py) ---
# App publicado no Replit que recebe a URL de um vídeo do YouTube e dispara
# geração de conteúdo + publicação cross-platform. A ponte
# (lib/tubeoptimizer_client.py) JÁ existe e é testável, mas ainda NÃO é chamada
# por nada no pipeline — vai ser importada quando a geração automática de
# Shorts existir. Ainda não se sabe em qual serviço isso vai morar, então por
# ora estas variáveis são globais do projeto (não estão amarradas a nenhum
# container no docker-compose.yml).
#
# URL raiz do app no Replit (sem barra final; ex.:
# https://tubeoptimizer.SEU-USUARIO.repl.co). SEM isto, a função lança erro
# claro antes de qualquer chamada de rede.
TUBEOPTIMIZER_BASE_URL=coloque_a_url_do_app_no_replit_aqui
# (Opcionais — têm padrão embutido)
# TUBEOPTIMIZER_API_KEY=            # se setado, vai no header "X-API-Key"
# TUBEOPTIMIZER_TIMEOUT_SEC=15      # timeout (connect+read) da chamada


# --- Short "O Mundo em 3 Minutos" (serviço "worldin3") ---------------------
# PARTE 1: geração do roteiro + composição vertical 9:16 + PREVIEW local:
#   docker compose run --rm worldin3 python -m worldin3.preview
#   (aceita --headlines N, --budget, --lipsync/--no-lipsync, --voice-file <mp3>)
# PARTE 2 (atual): upload real no YouTube + playlist + agendamento 3x/dia +
# ponte com o TubeOptimizer. O serviço tem profile "worldin3" (não sobe no
# `docker compose up`). Loop de agendamento:
#   docker compose --profile worldin3 up -d worldin3
# Uma edição manual (gera, PARA para aprovação; depois sobe):
#   docker compose run --rm worldin3 python -m worldin3.run_once generate
#   docker compose run --rm worldin3 python -m worldin3.run_once upload-last
#   docker compose run --rm worldin3 python -m worldin3.run_once tubeoptimizer
#
# Reaproveita, SEM caminho paralelo: manchetes de news.ready (mesmo critério do
# ticker), a mesma voz ElevenLabs (ELEVENLABS_*), os assets de estúdio e a
# trilha licenciada em loop.
#
# REVISÃO EDITORIAL: no worldin3 está DESLIGADA no docker-compose.yml
# (ENABLE_EDITORIAL_REVIEW=false naquele serviço, decisão de 01/09). Motivo: o
# encerramento do resumo usa CTA de like/inscrição (WORLDIN3_CLOSING_CTA) e os
# 3 revisores no Haiku 4.5 o reprovam sempre como "linguagem de rede social",
# travando 100% das edições. A base factual do resumo continua sendo o
# comentário por manchete, que JÁ passou pelos 3 revisores quando cada notícia
# rodou sozinha (ver worldin3/reviewbridge.py). Para religar: troque para
# ENABLE_EDITORIAL_REVIEW=true no serviço worldin3 E tire o like/inscrição do CTA.
#
# Nº de manchetes reais no resumo (5-6 recomendado).
WORLDIN3_HEADLINE_COUNT=6
# Alvo de palavras do roteiro (~430 ≈ 3 min de fala em PT-BR). O limite DURO é
# WORLDIN3_MAX_SECONDS; se o áudio passar disso o preview regenera mais curto.
WORLDIN3_TARGET_WORDS=430
# Teto de duração do vídeo, em segundos. 170 = 2:50, com margem contra a
# variação natural da fala (Shorts acima de 3:00 deixam de contar como Short).
WORLDIN3_MAX_SECONDS=170
# Encerramento falado (as 2-3 últimas frases do roteiro). Vai para o TTS: use
# acentuação e números por extenso ("vinte e quatro horas", não "24h"). Vazio =
# usa o texto embutido em worldin3/config.py. Como a revisão do worldin3 está
# desligada (ver acima), pode conter like/inscrição.
WORLDIN3_CLOSING_CTA=Confira mais notícias atualizadas no nosso canal, ao vivo vinte e quatro horas por dia. E não esqueça de dar um like e se inscrever no canal.
# Freio de gasto ElevenLabs PRÓPRIO do formato (contador Redis separado das
# notícias: "worldin3:elevenlabs:credits_used:AAAA-MM-DD"). Um resumo tem
# ~2.500-3.000 caracteres; 3x/dia ≈ 8-9k. Padrão 12000 com margem.
WORLDIN3_DAILY_CREDIT_BUDGET=12000
# Agenda das 3 edições/dia. HORÁRIO DE BRASÍLIA por padrão (o servidor roda em
# UTC — a conversão é feita pelo fuso abaixo, não pelo relógio do host). O loop
# (worldin3.scheduler --loop) dispara pipeline + upload em cada horário.
WORLDIN3_SCHEDULE_TIMES=08:00,14:00,20:00
WORLDIN3_SCHEDULE_TZ=America/Sao_Paulo
# Se o serviço subir até N min DEPOIS de um horário, ainda roda aquela edição
# (uma vez; trava anti-duplicata por slot no Redis). Acima disso, espera a
# próxima.
WORLDIN3_SCHEDULE_CATCHUP_MIN=20
# privacyStatus do upload: "unlisted" (rede de segurança nas primeiras
# execuções reais — dá para conferir antes de virar público), "public" ou
# "private". Troque para "public" quando aprovar as primeiras edições.
WORLDIN3_PRIVACY_STATUS=unlisted
# Playlist dedicada "FutureVerse News — Shorts". Crie na mão pelo YouTube Studio
# e cole o ID (PL...). Vazio = não adiciona a playlist nenhuma.
WORLDIN3_PLAYLIST_ID=
# Link da live 24h na descrição. Vazio = deriva do handle:
# https://www.youtube.com/<YOUTUBE_CHANNEL_HANDLE>/live
WORLDIN3_LIVE_URL=
# TubeOptimizer: NUNCA automático. Só dispara com `run_once.py tubeoptimizer`
# E com este interruptor ligado. autoPublish=true (produção). Usa
# TUBEOPTIMIZER_BASE_URL / TUBEOPTIMIZER_API_KEY definidos mais acima.
WORLDIN3_ENABLE_TUBEOPTIMIZER=false
WORLDIN3_TUBEOPTIMIZER_CONTENT_LINE=futurenews
# Lip-sync D-ID: interruptor PRÓPRIO (vazio/false = avatar estático, o mesmo
# fallback de sempre). ATENÇÃO DE CUSTO: o plano Pro do D-ID rende ~15 min de
# vídeo/mês; um resumo de 3 min 3x/dia consome isso em ~2 dias. Só ligue em
# janela de demonstração. Usa DID_API_KEY (definida mais acima).
WORLDIN3_ENABLE_LIPSYNC=false
# (Opcionais — têm padrão embutido, ajuste fino da composição sem rebuild)
# WORLDIN3_HEADLINE_SCAN=120        # quantas entradas de news.ready varrer
# WORLDIN3_TITLE_BLOCKLIST=BBC Inside Science,Tech Now,Tech Life,BBC News,Newscast
# WORLDIN3_SHORTEN_ATTEMPTS=2       # regenerações mais curtas se estourar o teto
# WORLDIN3_BG_CROP_X=0              # recorte do fundo p/ 9:16 (px; +/-)
# WORLDIN3_BG_CROP_Y=-150           # Y<0 mostra mais o topo da cena (menos chão)
# WORLDIN3_AVATAR_W=700
# WORLDIN3_AVATAR_H=980            # proporção do PNG (270:378) — não distorcer
# WORLDIN3_AVATAR_CAPTION_TUCK=268 # corte da âncora nos antebraços; as mãos
#                                  # (base do PNG) ficam escondidas atrás da faixa
# WORLDIN3_CAPTION_Y=1300           # topo da faixa de legenda (logo acima da UI do Shorts)
# WORLDIN3_CAPTION_STRIP_H=250
# WORLDIN3_CAPTION_FONTSIZE=46
# WORLDIN3_CAPTION_BOX_OPACITY=0.94 # opacidade do retângulo da faixa (tampa a âncora)
# WORLDIN3_ENABLE_TICKER=true       # ticker rolante abaixo da faixa de legenda
# WORLDIN3_TICKER_H=110
# WORLDIN3_TICKER_FONTSIZE=34
# WORLDIN3_TICKER_SPEED=150         # px/s do scroll
# WORLDIN3_BOTTOM_SCRIM_OPACITY=0.34 # degradê que preenche a base (zona da UI do Shorts)
# WORLDIN3_VOICE_GAIN=2.0           # ganho da voz antes da mixagem
# WORLDIN3_MUSIC_GAIN=0.12          # ganho da trilha em loop


# --- Monitor 24h do canal — serviço "ops-agent" --------------------------------
# Agente SÓ DE SAÍDA na VM: reporta um snapshot de saúde + heartbeat para o
# dashboard /canal no app Replit (TUBEOPTIMIZER). Nada novo fica exposto na VM.
# Fase 1 = só relatório. Fases 2/3 = executar whitelist (restart_*, inject_breaking)
# + watchdog. Ver docs/canal-monitor-plan.md.
#
# Segredo compartilhado com o dashboard: gere com `openssl rand -hex 32` e
# coloque O MESMO valor aqui e no secret CANAL_OPS_SHARED_SECRET do app Replit.
# Sem ele o container ops-agent nem sobe.
CANAL_OPS_SHARED_SECRET=coloque_o_mesmo_valor_do_secret_no_replit
# URL raiz do app Replit (deploy de produção). Já tem padrão embutido.
# CANAL_APP_BASE_URL=https://tube-oprtimizer.replit.app
# Intervalo entre relatórios (s).
# OPS_AGENT_REPORT_INTERVAL_SEC=20

